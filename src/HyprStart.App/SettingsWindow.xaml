<Window x:Class="HyprStart.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsWindowTitle}"
        Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <!-- Тёмный ComboBox в тон пилюлям: системный шаблон на прозрачном окне выглядит белёсым. -->
        <Style x:Key="SettingsComboStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PillBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Outer" CornerRadius="17" Background="{DynamicResource PillBrush}"
                                    BorderBrush="{DynamicResource PillBorderBrush}" BorderThickness="1" />
                            <ContentPresenter Margin="14,0,30,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{DynamicResource TextBrush}" />
                            <ToggleButton x:Name="Toggle" Focusable="False" Cursor="Hand"
                                          HorizontalAlignment="Right" Width="28" Background="Transparent"
                                          BorderThickness="0" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="0,4,0,0" CornerRadius="10" MinWidth="{TemplateBinding ActualWidth}"
                                        Background="{DynamicResource MenuBrush}"
                                        BorderBrush="{DynamicResource PillBorderBrush}" BorderThickness="1"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="220" Style="{DynamicResource DarkScrollBarStyle}">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Row" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource GlassTintBrush}"
            BorderBrush="{DynamicResource PanelBorderGradient}"
            BorderThickness="1" CornerRadius="16" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid Margin="20,16,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Шапка: заголовок + закрытие. За шапку окно таскается (WindowChrome не нужен). -->
            <Grid Grid.Row="0" Margin="0,0,0,14" Background="Transparent"
                  MouseLeftButtonDown="OnHeaderDrag">
                <TextBlock x:Name="HeaderText" Text="{DynamicResource SettingsHeader}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <Button x:Name="CloseButton" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        HorizontalAlignment="Right" Width="26" Height="26" Cursor="Hand"
                        Style="{DynamicResource QuickGlyphButtonStyle}" Click="OnClose"
                        ToolTip="{DynamicResource SettingsCloseToolTip}" />
            </Grid>

            <!-- MINI AI: универсальный OpenAI-совместимый клиент -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="MINI AI" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,8" />

                <TextBlock Text="{DynamicResource SettingsBaseUrl}" Foreground="{DynamicResource MutedBrush}"
                           FontSize="11" Margin="2,0,0,3" />
                <TextBox x:Name="BaseUrlBox" Style="{DynamicResource SearchBoxStyle}" Height="32" Margin="0,0,0,8" />

                <TextBlock Text="API Key" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="2,0,0,3" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ApiKeyBox" Grid.Column="0" Style="{DynamicResource SearchBoxStyle}"
                             Height="32" FontFamily="Consolas" />
                    <Button x:Name="RevealKeyButton" Grid.Column="1" Content="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                            Width="30" Height="32" Margin="6,0,0,0" Cursor="Hand"
                            Style="{DynamicResource QuickGlyphButtonStyle}" Click="OnRevealKey"
                            ToolTip="{DynamicResource SettingsRevealKey}" />
                </Grid>

                <TextBlock Text="Model" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="2,0,0,3" />
                <TextBox x:Name="ModelBox" Style="{DynamicResource SearchBoxStyle}" Height="32" Margin="0,0,0,6" />

                <TextBlock x:Name="KeyHint" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="2,0,0,8" />

                <CheckBox x:Name="HideChatBox" Content="{DynamicResource SettingsHideChat}"
                          Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="2,0,0,0" />
            </StackPanel>

            <!-- Хоткей + тема -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="{DynamicResource SettingsHotkeyHeader}" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,8" />
                    <Border Style="{DynamicResource PillStyle}" Height="34">
                        <TextBox x:Name="HotkeyBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextBrush}" FontSize="12"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 IsReadOnly="True" Cursor="Hand"
                                 PreviewKeyDown="OnHotkeyPreview" GotFocus="OnHotkeyFocus" LostFocus="OnHotkeyBlur" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{DynamicResource SettingsThemeHeader}" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,8" />
                    <ComboBox x:Name="ThemeBox" Style="{StaticResource SettingsComboStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                    <TextBlock Text="{DynamicResource SettingsLanguageHeader}" Style="{DynamicResource SectionHeaderStyle}"
                               Margin="0,0,0,8" />
                    <ComboBox x:Name="LanguageBox" Style="{StaticResource SettingsComboStyle}" MinWidth="86" />
                </StackPanel>
            </Grid>

            <!-- Автозапуск -->
            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                <TextBlock Text="{DynamicResource SettingsSystemHeader}" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,8" />
                <CheckBox x:Name="AutostartBox" Content="{DynamicResource SettingsAutostart}"
                          Foreground="{DynamicResource TextBrush}" FontSize="12" />
                <TextBlock Text="{DynamicResource SettingsAutostartHint}"
                           Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="24,3,0,0" />
            </StackPanel>

            <!-- Погода -->
            <StackPanel Grid.Row="4" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource SettingsWeatherHeader}" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CityBox" Grid.Column="0" Style="{DynamicResource SearchBoxStyle}" Height="32"
                             ToolTip="{DynamicResource SettingsCityToolTip}" />
                    <Button x:Name="DetectButton" Grid.Column="1" Content="&#xE707;" FontFamily="Segoe MDL2 Assets"
                            Width="30" Height="32" Margin="6,0,6,0" Cursor="Hand"
                            Style="{DynamicResource QuickGlyphButtonStyle}" Click="OnDetectCity"
                            ToolTip="{DynamicResource SettingsDetectToolTip}" />
                    <TextBox x:Name="LatBox" Grid.Column="2" Style="{DynamicResource SearchBoxStyle}" Height="32"
                             ToolTip="{DynamicResource SettingsLatToolTip}" />
                    <TextBlock Grid.Column="3" Text="," Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="6,0" />
                    <TextBox x:Name="LonBox" Grid.Column="4" Style="{DynamicResource SearchBoxStyle}" Height="32"
                             ToolTip="{DynamicResource SettingsLonToolTip}" />
                </Grid>
                <TextBlock x:Name="GeoHint" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="10"
                           TextWrapping="Wrap" Margin="2,5,0,0" />
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{DynamicResource SettingsCancel}" Height="32" MinWidth="92" Margin="0,0,8,0"
                        Cursor="Hand" Style="{DynamicResource QuickButtonStyle}" Click="OnClose" />
                <Button x:Name="SaveButton" Content="{DynamicResource SettingsSave}" Height="32" MinWidth="110"
                        Cursor="Hand" Style="{DynamicResource QuickButtonStyle}" Click="OnSave" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
