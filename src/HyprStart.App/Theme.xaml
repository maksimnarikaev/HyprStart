<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Палитра по референсу: льдисто-синий, лаванда, тёплые блики ===== -->
    <SolidColorBrush x:Key="GlassTintBrush" Color="#F80A0F1C" />
    <SolidColorBrush x:Key="DividerBrush" Color="#4D7FA9F0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#A9C4F5" />
    <SolidColorBrush x:Key="TextBrush" Color="#FCFDFF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#D6E2F2" />
    <SolidColorBrush x:Key="PillBrush" Color="#66142033" />
    <SolidColorBrush x:Key="PillBorderBrush" Color="#337FA9F0" />

    <!-- Клетка на фоне панелей: еле заметная сетка тонких диагональных линий.
         Тайл 108x108 рисует две линии под 45 градусов (крест в каждой ячейке),
         поэтому визуально это ромбы. DrawingBrush кэшируется и тайлится
         видеокартой - дешёвая альтернатива отдельным Line-элементам.

         ViewportUnits="Absolute" + AlignX/AlignY="Left/Top": сетка привязана к
         системе координат экрана, а не к левому верхнему углу каждой панели,
         поэтому линии идут непрерывно и совпадают на стыках соседних окон.
         Альфа 07 (~2.7%) - линии заметны ровно настолько, чтобы читалась
         фактура, но не перебивали иконки и текст. -->
    <DrawingBrush x:Key="GlassGridBrush"
                  TileMode="Tile"
                  Viewport="0,0,108,108"
                  ViewportUnits="Absolute"
                  Viewbox="0,0,108,108"
                  ViewboxUnits="Absolute"
                  AlignmentX="Left"
                  AlignmentY="Top"
                  Stretch="None"
                  RenderOptions.CachingHint="Cache"
                  RenderOptions.CacheInvalidationThresholdMinimum="0.5"
                  RenderOptions.CacheInvalidationThresholdMaximum="2.0">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="{x:Null}">
                <GeometryDrawing.Pen>
                    <Pen Brush="#07FFFFFF" Thickness="0.9" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="108,108" />
                        <LineGeometry StartPoint="108,0" EndPoint="0,108" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Рамка 45°: светлый льдистый -> насыщенный синий -->
    <LinearGradientBrush x:Key="PanelBorderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C7DCFF" Offset="0" />
        <GradientStop Color="#5B8DEF" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Тематические цвета элементов (заменяются ThemeService) ===== -->
    <SolidColorBrush x:Key="TileBrush" Color="#40070B14" />
    <SolidColorBrush x:Key="TileBorderBrush" Color="#667FA9F0" />
    <SolidColorBrush x:Key="HoverBrush" Color="#5A0E1B2E" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2A5B8DEF" />
    <SolidColorBrush x:Key="MenuBrush" Color="#F5131C30" />

    <LinearGradientBrush x:Key="CavaGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EAF2FF" Offset="0" />
        <GradientStop Color="#5B8DEF" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Векторная иконка папки для дерева приложений -->
    <Geometry x:Key="FolderGlyph">M2,4 L7,4 L9,6 L18,6 L18,15 L2,15 Z</Geometry>

    <!-- ===== Текст ===== -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="PlaceholderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PillTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Пилюля-бейдж для polybar ===== -->
    <Style x:Key="PillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PillBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- ===== Polybar-капсула: отдельный «парящий» островок вместо сплошной полосы ===== -->
    <Style x:Key="IslandStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderGradient}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- объём вместо софтверной тени: дешёвая внешняя обводка -->
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <!-- Внешняя тёмная обводка капсулы (тот же приём, что у панелей) -->
    <Style x:Key="IslandShadowStyle" TargetType="Border">
        <Setter Property="Margin" Value="-2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderBrush" Value="#4A0A1120" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ===== Поле поиска ===== -->
    <Style x:Key="SearchBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Тёмный скроллбар 4px ===== -->
    <Style x:Key="DarkScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="4" />
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb MinHeight="24">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource TileBorderBrush}" CornerRadius="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Строка списка приложений ===== -->
    <Style x:Key="AppItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,2,6,2" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Панель: матовое стекло, скругление 12, тёмная тень ===== -->
    <Style x:Key="PanelStyle" TargetType="HeaderedContentControl">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderGradient}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource GlassTintBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid>
                        <!-- объём: внешняя полупрозрачная тёмная обводка вместо софтверной тени -->
                        <Border Margin="-3"
                                CornerRadius="14"
                                BorderBrush="#4A0A1120"
                                BorderThickness="3" />

                        <!-- слой 1: однотонная полупрозрачная заливка, сквозь неё видно реальный экран -->
                        <Border CornerRadius="12" Background="{DynamicResource GlassTintBrush}" />

                        <!-- слой 1½: еле заметная клетка. Немного сжата по сторонам, чтобы
                             не вылезать за скруглённые углы. -->
                        <Border CornerRadius="12" Margin="1" IsHitTestVisible="False" Background="{DynamicResource GlassGridBrush}" />

                        <!-- слой 2: контент с градиентной рамкой, без эффектов.
                             Клип живёт на внутренней сетке, а не на этом Border: иначе
                             при дробной толщине (1.5 у активной панели) правая и нижняя
                             грани срезаются на полпикселя и рамка визуально исчезает. -->
                        <Border CornerRadius="12"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Margin="12,9,12,0"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,0,0,6">
                                    <Grid>
                                        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Style="{StaticResource SectionHeaderStyle}" />
                                        <ContentPresenter Content="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <ContentPresenter Grid.Row="1" Margin="12,8,12,12" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Плитка закреплённого ===== -->
    <!-- Размер по Width/Height задаёт PinTileGeometry через биндинг: сетка 4x2 подстраивается под ширину карточки -->
    <Style x:Key="PinTileStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource TileBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Кнопка быстрого доступа ===== -->
    <Style x:Key="QuickButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{DynamicResource TileBrush}"
                            BorderBrush="#337FA9F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8C7FA9F0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Компактная glyph-кнопка транспорта (трек в карточке «БЫСТРЫЙ ДОСТУП») ===== -->
    <Style x:Key="QuickGlyphButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8C7FA9F0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Тёмное контекстное меню ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- без системной рамки и колонки под иконки: только скруглённая подложка -->
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource MenuBrush}"
                            BorderBrush="{DynamicResource PanelBorderGradient}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="5"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <!-- без колонки под иконку: только подложка и текст -->
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"
                                                  VerticalAlignment="Center" />
                                <TextBlock x:Name="Arrow" Grid.Column="1" Text="›" Margin="12,0,0,0"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                           Visibility="Collapsed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               Placement="Right"
                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource MenuBrush}"
                                    BorderBrush="{DynamicResource PanelBorderGradient}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="4">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,2,0" />
    </Style>

</ResourceDictionary>
